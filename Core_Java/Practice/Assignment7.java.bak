import java.util.*;
class Assignment7
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int arr[]=new int[n];
		for(int i=0;i<n;i++){
			arr[i]=sc.nextInt();
		}
		System.out.print("Result: ");
		System.out.print("First Element: "+arr[0]+" Last Element: "+arr[n]);
	}
}