import java.util.*;
class Dynamic 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		String name=sc.nextString();
		int age=sc.nextInt();
		int grade=sc.nextInt();
		System.out.println("Name: "+name);
		System.out.println("Age: "+age);
		System.out.println("Grade: "+grade);
	}
}
