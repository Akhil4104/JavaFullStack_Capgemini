import java.util.*;
class NeonNumber 
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int num=(int)Math.pow(n,2);
		int sum=0;
		while(num>0){
			sum+=num%10;
			num/=10;
		}
		if(sum==n){
			System.out.println("same neon number");
		}
		else{
			System.out.println("not a neon number");
		}

	}
}
